package scalapb.perf

import org.openjdk.jmh.annotations.Benchmark
import org.openjdk.jmh.annotations.BenchmarkMode
import org.openjdk.jmh.annotations.Mode
import org.openjdk.jmh.annotations.OutputTimeUnit
import java.util.concurrent.TimeUnit

class ${Message}Test {
    @Benchmark
    @BenchmarkMode(Array(Mode.AverageTime))
    @OutputTimeUnit(TimeUnit.NANOSECONDS)
    def parseJava: ${JavaOuter}.${Message} = {
        ${JavaOuter}.${Message}.parseFrom(${Message}Test.bytes)
    }

    @Benchmark
    @BenchmarkMode(Array(Mode.AverageTime))
    @OutputTimeUnit(TimeUnit.NANOSECONDS)
    def parseScala: protos.${Message} = {
        protos.${Message}.parseFrom(${Message}Test.bytes)
    }

    @Benchmark
    @BenchmarkMode(Array(Mode.AverageTime))
    @OutputTimeUnit(TimeUnit.NANOSECONDS)
    def serializeJava: Array[Byte] = {
        ${Message}Test.java.toByteArray
    }

    @Benchmark
    @BenchmarkMode(Array(Mode.AverageTime))
    @OutputTimeUnit(TimeUnit.NANOSECONDS)
    def serializeScala: Array[Byte] = {
        ${Message}Test.scala.toByteArray
    }

    @Benchmark
    @BenchmarkMode(Array(Mode.AverageTime))
    @OutputTimeUnit(TimeUnit.NANOSECONDS)
    def roundTripScala: Array[Byte] = {
        val msg = protos.${Message}.parseFrom(${Message}Test.bytes)
        msg.toByteArray
    }

    @Benchmark
    @BenchmarkMode(Array(Mode.AverageTime))
    @OutputTimeUnit(TimeUnit.NANOSECONDS)
    def roundTripJava: Array[Byte] = {
        val msg = ${JavaOuter}.${Message}.parseFrom(${Message}Test.bytes)
        msg.toByteArray
    }
}

object ${Message}Test {
    val scala = TestCases.make${Message}Scala

    val bytes = scala.toByteArray

    val java = ${JavaOuter}.${Message}.parseFrom(bytes)
}
